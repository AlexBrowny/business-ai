# Ключ Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Telegram: создайте бота в @BotFather, добавьте его в группу менеджеров,
# chat_id группы (отрицательное число) узнайте через getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# База данных Turso (https://turso.tech). Если не заданы — используется локальный файл data/leads.db
# turso db create business-ai && turso db show business-ai --url && turso db tokens create business-ai
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Админка /admin
ADMIN_PASSWORD=change-me
# Любая длинная случайная строка (32+ символов)
SESSION_SECRET=
